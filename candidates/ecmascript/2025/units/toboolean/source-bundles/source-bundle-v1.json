    {
      "fragment_id": "ECMASCRIPT-2025-TOB-002",
      "document_id": "ecmascript-2025-html",
      "publisher": "Ecma International",
      "specification_version": "2025",
      "source_kind": "HTML",
      "section_number": "7.1.2",
      "section_heading": "ToBoolean",
      "html_anchor": "sec-toboolean",
      "html_line_start": 5135,
      "html_line_end": 5135,
      "exact_quote": "The abstract operation ToBoolean takes argument <var>argument</var> (an <emu-xref href=\"#sec-ecmascript-language-types\" id=\"_ref_2071\"><a href=\"#sec-ecmascript-language-types\">ECMAScript language value</a></emu-xref>) and returns a Boolean. It converts <var>argument</var> to a value of type Boolean. It performs the following steps when called:",
      "context_before": "5134:       <h1><span class=\"secnum\">7.1.2</span> ToBoolean ( <var>argument</var> )</h1>",
      "context_after": "5136:       <emu-alg><ol><li><span aria-hidden=\"true\" class=\"list-marker\">1. </span>If <var>argument</var> <emu-xref href=\"#sec-ecmascript-language-types-boolean-type\" id=\"_ref_2072\"><a href=\"#sec-ecmascript-language-types-boolean-type\">is a Boolean</a></emu-xref>, return <var>argument</var>.",
      "local_source_path": "documents/sources/ecmascript/2025/raw/specification.html",
      "source_sha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
      "fragment_sha256": null,
      "reason_for_inclusion": "Defines the conversion signature: input is an ECMAScript language value and output is Boolean."
    },
    {
      "fragment_id": "ECMASCRIPT-2025-TOB-003",
      "document_id": "ecmascript-2025-html",
      "publisher": "Ecma International",
      "specification_version": "2025",
      "source_kind": "HTML",
      "section_number": "7.1.2",
      "section_heading": "ToBoolean",
      "html_anchor": "sec-toboolean",
      "html_line_start": 5136,
      "html_line_end": 5136,
      "exact_quote": "If <var>argument</var> is one of <emu-val>undefined</emu-val>, <emu-val>null</emu-val>, <emu-val>+0</emu-val><sub>𝔽</sub>, <emu-val>-0</emu-val><sub>𝔽</sub>, <emu-val>NaN</emu-val>, <emu-val>0</emu-val><sub>ℤ</sub>, or the empty String, return <emu-val>false</emu-val>.",
      "context_before": "5136:       <emu-alg><ol><li><span aria-hidden=\"true\" class=\"list-marker\">1. </span>If <var>argument</var> <emu-xref href=\"#sec-ecmascript-language-types-boolean-type\" id=\"_ref_2072\"><a href=\"#sec-ecmascript-language-types-boolean-type\">is a Boolean</a></emu-xref>, return <var>argument</var>.</li><li><span aria-hidden=\"true\" class=\"list-marker\">2. </span>If <var>argument</var> is one of <emu-val>undefined</emu-val>, <emu-val>null</emu-val>, <emu-val>+0</emu-val><sub>𝔽</sub>, <emu-val>-0</emu-val><sub>𝔽</sub>, <emu-val>NaN</emu-val>, <emu-val>0</emu-val><sub>ℤ</sub>, or the empty String, return <emu-val>false</emu-val>.",
      "context_after": "5136:       <emu-alg><ol><li><span aria-hidden=\"true\" class=\"list-marker\">1. </span>If <var>argument</var> <emu-xref href=\"#sec-ecmascript-language-types-boolean-type\" id=\"_ref_2072\"><a href=\"#sec-ecmascript-language-types-boolean-type\">is a Boolean</a></emu-xref>, return <var>argument</var>.</li><li><span aria-hidden=\"true\" class=\"list-marker\">2. </span>If <var>argument</var> is one of <emu-val>undefined</emu-val>, <emu-val>null</emu-val>, <emu-val>+0</emu-val><sub>𝔽</sub>, <emu-val>-0</emu-val><sub>𝔽</sub>, <emu-val>NaN</emu-val>, <emu-val>0</emu-val><sub>ℤ</sub>, or the empty String, return <emu-val>false</emu-val>.</li><li id=\"step-to-boolean-web-compat-insertion-point\"><span aria-hidden=\"true\" class=\"list-marker\">3. </span>NOTE: This step is replaced in section <emu-xref href=\"#sec-IsHTMLDDA-internal-slot-to-boolean\" id=\"_ref_201\"><a href=\"#sec-IsHTMLDDA-internal-slot-to-boolean\">B.3.6.1</a></emu-xref>.</li><li><span aria-hidden=\"true\" class=\"list-marker\">4. </span>Return <emu-val>true</emu-val>.</li></ol></emu-alg>",
      "local_source_path": "documents/sources/ecmascript/2025/raw/specification.html",
      "source_sha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
      "fragment_sha256": null,
      "reason_for_inclusion": "Contains the explicit false-value branch and true fallback for ToBoolean."
    },
    {
      "fragment_id": "ECMASCRIPT-2025-TOB-004",
      "document_id": "ecmascript-2025-html",
      "publisher": "Ecma International",
      "specification_version": "2025",
      "source_kind": "HTML",
