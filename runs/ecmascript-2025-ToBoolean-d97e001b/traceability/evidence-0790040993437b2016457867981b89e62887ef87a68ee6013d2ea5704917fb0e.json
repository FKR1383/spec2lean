          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
          "locator": {
            "section": "7.1.2",
            "heading": "ToBoolean",
            "anchor": "sec-toboolean",
            "startLine": 5135,
            "endLine": 5135
          },
          "quotation": "The abstract operation ToBoolean takes argument <var>argument</var> (an <emu-xref href=\"#sec-ecmascript-language-types\" id=\"_ref_2071\"><a href=\"#sec-ecmascript-language-types\">ECMAScript language value</a></emu-xref>) and returns a Boolean. It converts <var>argument</var> to a value of type Boolean."
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-003",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/ecmascript/2025/raw/specification.html",
          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
          "locator": {
            "section": "7.1.2",
            "heading": "ToBoolean",
            "anchor": "sec-toboolean",
            "startLine": 5136,
            "endLine": 5136
          },
          "quotation": "If <var>argument</var> <emu-xref href=\"#sec-ecmascript-language-types-boolean-type\" id=\"_ref_2072\"><a href=\"#sec-ecmascript-language-types-boolean-type\">is a Boolean</a></emu-xref>, return <var>argument</var>."
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-004",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/ecmascript/2025/raw/specification.html",
          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
          "locator": {
            "section": "7.1.2",
            "heading": "ToBoolean",
            "anchor": "sec-toboolean",
            "startLine": 5136,
            "endLine": 5136
          },
          "quotation": "If <var>argument</var> is one of <emu-val>undefined</emu-val>, <emu-val>null</emu-val>, <emu-val>+0</emu-val><sub>𝔽</sub>, <emu-val>-0</emu-val><sub>𝔽</sub>, <emu-val>NaN</emu-val>, <emu-val>0</emu-val><sub>ℤ</sub>, or the empty String, return <emu-val>false</emu-val>."
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-005",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/ecmascript/2025/raw/specification.html",
          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
          "locator": {
            "section": "7.1.2",
