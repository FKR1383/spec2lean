{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/traceability/evidence-manifest-v2.json",
  "title": "Spec2Lean evidence manifest v2",
  "type": "object",
  "required": ["schemaVersion", "manifestType", "generator", "runId", "language", "specificationVersion", "unit", "documentRole", "sourceManifest", "leanDocument", "semanticDocument", "sourceBundles", "entries", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "manifestType": { "const": "spec2lean_evidence_manifest" },
    "generator": { "const": "spec2lean-traceability-v2" },
    "runId": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "documentRole": { "enum": ["SEMANTICS", "PROOFS"] },
    "sourceManifest": { "$ref": "evidence-manifest.schema.json#/$defs/fingerprint" },
    "leanDocument": { "$ref": "evidence-manifest.schema.json#/$defs/fingerprint" },
    "semanticDocument": { "$ref": "evidence-manifest.schema.json#/$defs/fingerprint" },
    "sourceBundles": { "type": "array", "minItems": 1, "items": { "$ref": "evidence-manifest.schema.json#/$defs/fingerprint" } },
    "theoremDocument": { "$ref": "evidence-manifest.schema.json#/$defs/fingerprint" },
    "entries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "evidence-manifest.schema.json#/$defs/entry" },
          {
            "type": "object",
            "required": ["theoremObligationIds"],
            "properties": { "theoremObligationIds": { "$ref": "evidence-manifest.schema.json#/$defs/stringArray" } }
          }
        ]
      }
    },
    "diagnostics": { "$ref": "evidence-manifest.schema.json#/properties/diagnostics" }
  },
  "allOf": [
    {
      "if": { "properties": { "documentRole": { "const": "PROOFS" } } },
      "then": { "required": ["theoremDocument"] }
    }
  ]
}
