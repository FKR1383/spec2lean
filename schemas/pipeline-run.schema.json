{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/pipeline-run.schema.json",
  "title": "Spec2Lean pipeline run",
  "type": "object",
  "required": [
    "schemaVersion", "phase", "pipelineRunId", "request", "createdAt",
    "updatedAt", "status", "fromPhase", "untilPhase", "dryRun", "sharedCore", "units"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "phase": {"const": "PIPELINE"},
    "pipelineRunId": {"type": "string", "pattern": "^pipeline-run:"},
    "request": {"type": "object"},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "INTERRUPTED", "NEEDS_ROUTING", "DRY_RUN"]},
    "fromPhase": {"enum": ["index", "plan", "evidence", "semantics", "translate", "check", "troubleshoot"]},
    "untilPhase": {"enum": ["index", "plan", "evidence", "semantics", "translate", "check", "troubleshoot"]},
    "dryRun": {"type": "boolean"},
    "maxQuestionRounds": {"type": "integer", "minimum": 0},
    "phase1": {"type": ["object", "null"]},
    "planRunId": {"type": ["string", "null"]},
    "planDirectory": {"type": ["string", "null"]},
    "plan": {"type": "object"},
    "sharedCore": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["disposition"],
          "properties": {
            "disposition": {"enum": ["NOT_REQUIRED", "REUSED", "BUILT", "WOULD_BUILD"]},
            "coreRunId": {"type": "string", "pattern": "^shared-core-run:[0-9a-f]{24}$"},
            "manifestHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "sourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "leanModule": {"type": "string", "minLength": 1},
            "staleReasons": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "allOf": [{
            "if": {
              "properties": {"disposition": {"enum": ["REUSED", "BUILT"]}},
              "required": ["disposition"]
            },
            "then": {
              "required": ["coreRunId", "manifestHash", "sourceHash", "leanModule"]
            }
          }],
          "additionalProperties": false
        }
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "status", "stages"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PENDING", "RUNNING", "PLANNED", "PASS", "FAIL"]},
          "stages": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
