          "quotation": "<emu-clause id=\"sec-toboolean\" oldids=\"table-toboolean-conversions\" type=\"abstract operation\" aoid=\"ToBoolean\"><span id=\"table-toboolean-conversions\"></span>"
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-002",
