{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/semantic/shared-environment-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentId",
    "language",
    "specificationVersion",
    "revision",
    "scope",
    "review",
    "sourceManifests",
    "evidence",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environmentId": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "statement",
        "eligibilityRequirements",
        "excludedFeatures",
        "outsideScopeAction"
      ],
      "properties": {
        "scopeId": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "eligibilityRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excludedFeatures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "outsideScopeAction": { "const": "DEEP_REVIEW_OR_LEGACY_FALLBACK" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "records"],
      "properties": {
        "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_REVIEW", "HUMAN_APPROVED"] },
        "records": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/fingerprint" },
          "uniqueItems": true
        }
      }
    },
    "sourceManifests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/fingerprint" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/evidence" }
    },
    "entries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/claim" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["specificationVersion", "scope", "provenance", "review"],
            "properties": {
              "semanticId": true,
              "classification": true,
              "statement": true,
              "evidenceIds": true,
              "dependencyIds": true,
              "stateAffecting": true,
              "humanApprovalDependencies": true,
              "lifecycle": true,
              "review": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_REVIEW", "HUMAN_APPROVED"] },
                  "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] }
                }
              },
              "specificationVersion": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "required": ["originatingArtifacts", "reviewRecords", "acceptedUnitSupport"],
                "properties": {
                  "originatingArtifacts": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "common.schema.json#/$defs/fingerprint" }
                  },
                  "reviewRecords": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/fingerprint" }
                  },
                  "acceptedUnitSupport": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["unit", "acceptedEvidenceIds", "artifacts", "reviewRecords"],
                      "properties": {
                        "unit": { "type": "string", "minLength": 1 },
                        "acceptedEvidenceIds": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string", "minLength": 1 },
                          "uniqueItems": true
                        },
                        "artifacts": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "$ref": "common.schema.json#/$defs/fingerprint" }
                        },
                        "reviewRecords": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "$ref": "common.schema.json#/$defs/fingerprint" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
