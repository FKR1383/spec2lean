{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/semantic/language-core-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coreId", "language", "specificationVersion", "scope", "semanticEnvironment", "leanModule", "modelRoles", "reviewBinding"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "coreId": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "eligibilityRequirements", "outsideScopeAction"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "eligibilityRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outsideScopeAction": { "const": "BOOTSTRAP_OR_DEEP_REVIEW" }
      }
    },
    "semanticEnvironment": { "$ref": "common.schema.json#/$defs/fingerprint" },
    "leanModule": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/fingerprint" },
        {
          "type": "object",
          "required": ["importName"],
          "properties": { "importName": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "modelRoles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leanDeclaration", "semanticIds"],
        "properties": {
          "leanDeclaration": { "type": "string", "minLength": 1 },
          "semanticIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "proofDischarges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dischargeId", "correctnessKind", "semanticIds", "leanModule", "theoremDeclarations", "reviewRecords"],
        "properties": {
          "dischargeId": { "type": "string", "minLength": 1 },
          "correctnessKind": { "type": "string", "minLength": 1 },
          "semanticIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "leanModule": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/fingerprint" },
              { "type": "object", "required": ["importName"], "properties": { "importName": { "type": "string", "minLength": 1 } } }
            ]
          },
          "theoremDeclarations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "reviewRecords": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/fingerprint" } }
        }
      }
    },
    "reviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "records"],
      "properties": {
        "status": { "enum": ["BOUND_TO_HUMAN_APPROVED_SEMANTICS", "HUMAN_APPROVED"] },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/fingerprint" } }
      }
    }
  }
}
