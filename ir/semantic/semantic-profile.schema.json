{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/semantic/profile-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "languageCorePath",
    "specificationVersion",
    "strategy",
    "sharedEnvironmentPath",
    "supportedUnitPatterns",
    "requiredSharedSemanticIds",
    "requiredSharedClassifications",
    "approval",
    "safety",
    "fallback"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "language": { "type": "string", "minLength": 1 },
    "languageCorePath": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "strategy": { "const": "DELTA_PREFERRED_WITH_LEGACY_FALLBACK" },
    "sharedEnvironmentPath": { "type": "string", "minLength": 1 },
    "supportedUnitPatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requiredSharedSemanticIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requiredSharedClassifications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["SOURCE_FACT", "DERIVED_INTERPRETATION", "DESIGN_DEPENDENCY", "ASSUMPTION", "OPEN_QUESTION"]
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewCandidatePath", "humanReviewPacketPath", "approvedEnvironmentPath", "approvalRecordPath"],
      "properties": {
        "reviewCandidatePath": { "type": "string", "minLength": 1 },
        "humanReviewPacketPath": { "type": "string", "minLength": 1 },
        "approvedEnvironmentPath": { "type": "string", "minLength": 1 },
        "approvalRecordPath": { "type": "string", "minLength": 1 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireHumanApprovedEnvironment",
        "requireActiveApprovedEntries",
        "blockStateAffectingOpenQuestions",
        "verifySourceBundleFingerprint",
        "verifyOfficialEvidenceFingerprints"
      ],
      "properties": {
        "requireHumanApprovedEnvironment": { "const": true },
        "requireActiveApprovedEntries": { "const": true },
        "blockStateAffectingOpenQuestions": { "const": true },
        "verifySourceBundleFingerprint": { "const": true },
        "verifyOfficialEvidenceFingerprints": { "const": true }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "description"],
      "properties": {
        "enabled": { "const": true },
        "mode": { "const": "LEGACY_FULL_SEMANTICS" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
