      "html_line_start": 14309,
      "html_line_end": 14316,
      "exact_quote": "The size of the operands must match, but not necessarily the type.\nAllowed types include predicate registers.\nPTX ISA Notes\nIntroduced in PTX ISA version 1.0.\nTarget ISA Notes\nSupported on all target architectures.",
      "local_source_path": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
      "source_sha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
