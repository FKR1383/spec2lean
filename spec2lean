#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [[ -x "$repo_dir/.venv/bin/python" ]]; then
  python_bin="$repo_dir/.venv/bin/python"
else
  python_bin="python3"
fi
PYTHONPATH="$repo_dir/src${PYTHONPATH:+:$PYTHONPATH}" exec "$python_bin" -m spec2lean "$@"

