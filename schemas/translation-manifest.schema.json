{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/translation-manifest.schema.json",
  "title": "Spec2Lean Phase-5 Group Translation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "planRunId", "language", "version", "group", "translationRunId", "semanticsArtifacts", "translator", "target", "leanFile", "createdAt", "declarations", "sharedCore", "sharedUses"],
  "properties": {
    "schemaVersion": {"const": 3},
    "phase": {"const": "LLM_GROUP_TRANSLATOR"},
    "planRunId": {"type": "string", "pattern": "^plan:"},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "group": {
      "type": "object", "additionalProperties": false, "required": ["name", "unitIds"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "unitIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^unit:"}}
      }
    },
    "translationRunId": {"type": "string", "pattern": "^translation-group-run:"},
    "semanticsArtifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["unitId", "runId", "artifactHash"],
        "properties": {
          "unitId": {"type": "string", "pattern": "^unit:"},
          "runId": {"type": "string", "pattern": "^semantic-run:"},
          "artifactHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "translator": {
      "type": "object", "additionalProperties": false, "required": ["provider", "model", "reasoning"],
      "properties": {
        "provider": {"const": "opencode"},
        "model": {"enum": ["openai/gpt-5.6-sol", "openai/gpt-5.4-mini", "openai/gpt-5.3-codex-spark"]},
        "reasoning": {"enum": ["medium", "low"]}
      },
      "oneOf": [
        {"properties": {"model": {"const": "openai/gpt-5.6-sol"}, "reasoning": {"const": "medium"}}},
        {"properties": {"model": {"enum": ["openai/gpt-5.4-mini", "openai/gpt-5.3-codex-spark"]}, "reasoning": {"const": "low"}}}
      ]
    },
    "target": {"type": "object", "additionalProperties": false, "required": ["language", "version"], "properties": {"language": {"const": "Lean"}, "version": {"const": "4"}}},
    "leanFile": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*\\.lean$"},
    "createdAt": {"type": "string", "minLength": 1},
    "sharedCore": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["coreRunId", "manifestHash", "sourceHash", "leanModule"],
          "properties": {
            "coreRunId": {"type": "string", "pattern": "^shared-core-run:[0-9a-f]{24}$"},
            "manifestHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "sourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "leanModule": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$"}
          }
        }
      ]
    },
    "sharedUses": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dependencyId", "leanDeclarations", "claimRefs"],
        "properties": {
          "dependencyId": {"type": "string", "pattern": "^shared:"},
          "leanDeclarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$"}},
          "claimRefs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["unitId", "claimId"],
              "properties": {"unitId": {"type": "string", "pattern": "^unit:"}, "claimId": {"type": "string", "pattern": "^claim:"}}
            }
          }
        }
      }
    },
    "declarations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["declaration", "role", "claimRefs"],
        "properties": {
          "declaration": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$"},
          "role": {"enum": ["PRIMARY_TYPE", "OPERATION", "EXECUTION", "BRANCH_HELPER", "EDGE_CASE_HELPER", "SEMANTIC_HELPER", "IMPLEMENTATION_HELPER"]},
          "claimRefs": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["unitId", "claimId"],
              "properties": {"unitId": {"type": "string", "pattern": "^unit:"}, "claimId": {"type": "string", "pattern": "^claim:"}}
            }
          },
          "supportsDeclarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$"}},
          "sourceRange": {
            "type": "object", "additionalProperties": false,
            "required": ["file", "startLine", "endLine"],
            "properties": {
              "file": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*\\.lean$"},
              "startLine": {"type": "integer", "minimum": 1},
              "endLine": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
