{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/plan.schema.json",
  "title": "Spec2Lean Phase-2 Formalization Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specification",
    "units",
    "dependencies",
    "stronglyConnectedComponents",
    "processingLayers"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version", "indexSemanticDigest"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "indexSemanticDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "stronglyConnectedComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sccId", "unitIds", "cyclic"],
        "properties": {
          "sccId": {"type": "string", "pattern": "^scc:[0-9]{3,}$"},
          "unitIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cyclic": {"type": "boolean"}
        }
      }
    },
    "processingLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "sccIds", "unitIds"],
        "properties": {
          "layer": {"type": "integer", "minimum": 0},
          "sccIds": {"type": "array", "items": {"type": "string"}},
          "unitIds": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "name", "kind", "sourceNodeIds", "instructionNames"],
      "properties": {
        "unitId": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "ARCHITECTURE", "STATE_MODEL", "TYPE_SYSTEM", "EXECUTION_MODEL",
            "OPERAND_MODEL", "MEMORY_MODEL", "ABI", "INSTRUCTION_FAMILY",
            "INSTRUCTION", "DIRECTIVE", "SPECIAL_REGISTER", "OTHER"
          ]
        },
        "sourceNodeIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "instructionNames": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["INSTRUCTION", "INSTRUCTION_FAMILY"]}}},
          "then": {"properties": {"instructionNames": {"minItems": 1}}}
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromUnitId", "toUnitId", "type", "reason", "sourceNodeIds", "origin"],
      "properties": {
        "fromUnitId": {"type": "string"},
        "toUnitId": {"type": "string"},
        "type": {
          "enum": [
            "USES_STATE_MODEL", "USES_TYPE_SYSTEM", "USES_EXECUTION_MODEL",
            "USES_OPERAND_MODEL", "USES_MEMORY_MODEL", "USES_INSTRUCTION", "REQUIRES"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "sourceNodeIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "origin": {"enum": ["EXPLICIT", "INFERRED"]}
      }
    }
  }
}
