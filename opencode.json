{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "enabled_providers": [
    "opencode"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.3-codex-spark": {
          "options": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "edit": {
      "*": "ask",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "accepted/**": "deny",
      "**/accepted/**": "deny",
      "lean/.lake/**": "deny",
      "**/.lake/**": "deny"
    },
    "bash": {
      "*": "ask",
      "sudo": "deny",
      "sudo *": "deny",
      "rm": "deny",
      "rm *": "deny",
      "chmod": "deny",
      "chmod *": "deny",
      "chown": "deny",
      "chown *": "deny",
      "git push*": "deny",
      "git commit*": "deny",
      "git tag*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "kill": "deny",
      "kill *": "deny",
      "pkill": "deny",
      "pkill *": "deny"
    },
    "spec_read_span": "deny",
    "spec_search": "deny",
    "spec_get_context": "deny",
    "candidate_read": "deny",
    "candidate_write": "deny",
    "candidate_diff": "deny",
    "lean_check_file": "deny",
    "lean_get_diagnostics": "deny",
    "lean_get_goals": "deny",
    "lean_run_eval": "deny",
    "review_submit": "deny",
    "spec_pdf_search": "deny",
    "spec_pdf_read_pages": "deny"
  }
}
