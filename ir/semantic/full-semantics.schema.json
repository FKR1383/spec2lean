{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/semantic/full-semantics-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "interpretationId",
    "unit",
    "provenance",
    "semanticClaims",
    "syntaxForms",
    "operands",
    "operation",
    "stateEffects",
    "preconditions",
    "proofFamilies"
  ],
  "properties": {
    "schemaVersion": { "enum": [2, 3] },
    "documentType": { "const": "spec2lean_full_semantics" },
    "interpretationId": { "type": "string", "minLength": 1 },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "specificationVersion", "unit", "unitSlug"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "specificationVersion": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "unitSlug": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "sourceBundles", "gateAAuthority"],
      "properties": {
        "architecture": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "sourceBundles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/fingerprint" }
        },
        "gateAAuthority": {
          "enum": ["HUMAN_APPROVED", "BENCHMARK_AUTO_ADVANCED_NOT_HUMAN_APPROVED"]
        }
      }
    },
    "semanticClaims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/claim" }
    },
    "syntaxForms": { "$ref": "instruction-delta.schema.json#/$defs/syntaxForms" },
    "operands": { "$ref": "instruction-delta.schema.json#/$defs/operands" },
    "operation": { "$ref": "instruction-delta.schema.json#/$defs/operation" },
    "stateEffects": { "$ref": "instruction-delta.schema.json#/$defs/stateEffects" },
    "preconditions": { "$ref": "instruction-delta.schema.json#/$defs/preconditions" },
    "proofFamilies": { "$ref": "instruction-delta.schema.json#/$defs/proofFamilies" },
    "scopeStatus": { "enum": ["FULL_INSTRUCTION", "PARTIAL_EXPLICIT"] },
    "coverage": { "$ref": "instruction-delta.schema.json#/$defs/completenessCoverage" },
    "proofRequirements": { "$ref": "instruction-delta.schema.json#/$defs/proofRequirements" },
    "languageCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["REUSED_APPROVED", "BOOTSTRAP_CANDIDATE"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "environmentId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "candidateCoreId": { "type": "string", "minLength": 1 },
        "scopeStatement": { "type": "string", "minLength": 1 },
        "eligibilityRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reusableSemanticClaimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "proposedModelRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "semanticClaimIds"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "semanticClaimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "REUSED_APPROVED" } } },
          "then": { "required": ["path", "sha256"] }
        },
        {
          "if": { "properties": { "status": { "const": "BOOTSTRAP_CANDIDATE" } } },
          "then": { "required": ["candidateCoreId", "scopeStatement", "eligibilityRequirements", "reusableSemanticClaimIds", "proposedModelRoles"] }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 3 } } },
      "then": { "required": ["scopeStatus", "coverage", "proofRequirements", "languageCore"] }
    }
  ]
}
