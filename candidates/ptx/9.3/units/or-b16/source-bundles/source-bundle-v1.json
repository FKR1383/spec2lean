      "html_line_end": 8723,
      "exact_quote": "All PTX instructions may be predicated. In the following descriptions, the optional guard predicate is omitted from the syntax.",
      "local_source_path": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
