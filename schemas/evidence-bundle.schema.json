{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/evidence-bundle.schema.json",
  "title": "Spec2Lean Phase-3 Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "planRunId",
    "language",
    "version",
    "sourceDatabaseDigest",
    "unit",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"const": "RETRIEVE_EVIDENCE"},
    "planRunId": {"type": "string", "pattern": "^plan:"},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sourceDatabaseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit": {
      "type": "object",
      "required": ["unitId", "name", "sourceNodeIds"],
      "properties": {
        "unitId": {"type": "string", "pattern": "^unit:"},
        "name": {"type": "string", "minLength": 1},
        "sourceNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^node:"},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "resolutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/resolutionRecord"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "bbox": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spanId", "ordinal", "exactText", "page", "bbox", "blockIndex",
        "lineIndex", "spanIndex", "domPath", "sourceLineStart", "sourceLineEnd"
      ],
      "properties": {
        "spanId": {"type": "string", "pattern": "^span:"},
        "ordinal": {"type": "integer", "minimum": 0},
        "exactText": {"type": "string"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "blockIndex": {"type": ["integer", "null"]},
        "lineIndex": {"type": ["integer", "null"]},
        "spanIndex": {"type": ["integer", "null"]},
        "domPath": {"$ref": "#/$defs/nullableString"},
        "sourceLineStart": {"type": ["integer", "null"]},
        "sourceLineEnd": {"type": ["integer", "null"]}
      }
    },
    "provenanceFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId", "nodeType", "sectionNumber", "sectionTitle",
        "htmlAnchor", "pageStart", "pageEnd", "sourceSpans"
      ],
      "properties": {
        "sourceNodeId": {"type": "string", "pattern": "^node:"},
        "nodeType": {"type": "string", "minLength": 1},
        "sectionNumber": {"$ref": "#/$defs/nullableString"},
        "sectionTitle": {"$ref": "#/$defs/nullableString"},
        "htmlAnchor": {"$ref": "#/$defs/nullableString"},
        "pageStart": {"type": ["integer", "null"]},
        "pageEnd": {"type": ["integer", "null"]},
        "sourceSpans": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      }
    },
    "selectionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNodeId", "basis"],
      "properties": {
        "sourceNodeId": {"type": "string", "pattern": "^node:"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "resolutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionId", "unitId", "questionId", "sourceKind", "role",
        "statement", "rationale", "nonNormative", "provenance"
      ],
      "properties": {
        "resolutionId": {"type": "string", "pattern": "^resolution:[0-9a-f]{32}$"},
        "unitId": {"type": "string", "pattern": "^unit:"},
        "questionId": {"type": "string", "pattern": "^question:"},
        "sourceKind": {"enum": ["INTERNET", "RUNTIME", "LLM_REASONING"]},
        "role": {
          "enum": [
            "SYNTAX", "OPERANDS", "TYPE_RULES", "OPERATION", "ALGORITHM",
            "EDGE_CASE", "STATE_EFFECT", "PREDICATION",
            "VERSION_OR_TARGET_RESTRICTION", "EXAMPLE", "SUPPORTING_DEFINITION",
            "OTHER"
          ]
        },
        "statement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "nonNormative": {"const": true},
        "provenance": {"type": "object"}
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId", "unitId", "role", "tier", "rationale", "sourceNodeId",
        "sourceNodeIds", "sourceSpanIds", "sourceType", "sectionNumber",
        "sectionTitle", "exactText", "documentId", "documentSha256", "sourcePath",
        "officialUrl", "htmlAnchor", "pdfPage", "bbox", "selectionBasis", "provenance"
      ],
      "properties": {
        "evidenceId": {"type": "string", "pattern": "^evidence:[0-9a-f]{32}$"},
        "unitId": {"type": "string", "pattern": "^unit:"},
        "role": {
          "enum": [
            "SYNTAX", "OPERANDS", "TYPE_RULES", "OPERATION", "ALGORITHM",
            "EDGE_CASE", "STATE_EFFECT", "PREDICATION",
            "VERSION_OR_TARGET_RESTRICTION", "EXAMPLE", "SUPPORTING_DEFINITION",
            "OTHER"
          ]
        },
        "tier": {"enum": ["CORE", "SUPPORTING"]},
        "rationale": {"type": "string", "minLength": 1},
        "sourceNodeId": {"type": "string", "pattern": "^node:"},
        "sourceNodeIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^node:"}, "uniqueItems": true},
        "sourceSpanIds": {"type": "array", "items": {"type": "string", "pattern": "^span:"}, "uniqueItems": true},
        "sourceType": {"enum": ["html", "pdf"]},
        "sectionNumber": {"$ref": "#/$defs/nullableString"},
        "sectionTitle": {"$ref": "#/$defs/nullableString"},
        "exactText": {"type": "string", "minLength": 1},
        "documentId": {"type": "string", "pattern": "^doc:"},
        "documentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourcePath": {"type": "string", "minLength": 1},
        "officialUrl": {"$ref": "#/$defs/nullableString"},
        "htmlAnchor": {"$ref": "#/$defs/nullableString"},
        "pdfPage": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "selectionBasis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selectionBasis"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenanceFragment"}}
      }
    }
  }
}
