      ],
      "theoremObligationIds": [],
      "claims": [
        {
          "semanticId": "PTX-AND-SEM2-013",
          "classification": "SOURCE_FACT",
          "statement": ".b32 is a fundamental type specifier of basic type 'Bits (untyped)'; Table 8 lists .b8, .b16, .b32, .b64, .b128 under 'Bits (untyped)' and .pred under 'Predicate'.",
          "evidenceIds": [
            "CTX-04"
          ]
        },
        {
          "semanticId": "PTX-AND-SEM2-015",
          "classification": "SOURCE_FACT",
          "statement": "Registers (.reg state space) are fast storage locations; aside from 1-bit predicate registers, scalar registers have a width of 8-, 16-, 32-, 64-, or 128-bits (32-bit width is therefore possible for .b32 registers); registers may be typed or untyped.",
          "evidenceIds": [
            "CTX-03"
          ]
        },
        {
          "semanticId": "PTX-AND-SEM2-026",
          "classification": "DERIVED_INTERPRETATION",
          "statement": "The result width of the bounded base and.b32 form is 32 bits, derived from the .b32 type specifier (AND_TYPE_SPECIFIERS), the 'Bits (untyped)' fundamental type of size 32 (CTX-04), and the 32-bit scalar register width (CTX-03). The bundle's gap GAP_NO_EXPLICIT_RESULT_WIDTH_PROSE (informational) records that no prose in the section explicitly states the result width equals 32 bits; the width is derived from the type, not from a dedicated prose sentence (open question PTX-AND-SEM2-069).",
          "evidenceIds": [
            "AND_TYPE_SPECIFIERS",
            "CTX-03",
            "CTX-04"
          ]
        }
      ],
      "evidence": [
        {
          "evidenceId": "AND_TYPE_SPECIFIERS",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
          "documentSha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
          "locator": {
            "startLine": 14266,
            "endLine": 14266
          },
          "quotation": ".type = { .pred, .b16, .b32, .b64 };"
        },
        {
          "evidenceId": "CTX-03",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
          "documentSha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
          "locator": {
            "section": "5.1.1",
            "heading": "Register State Space",
            "anchor": "register-state-space",
            "startLine": 2613,
            "endLine": 2632
          },
          "quotation": "Registers ( .reg state space) are fast storage locations. The number of registers is limited, and will vary from platform to platform. When the limit is exceeded, register variables will be spilled to memory, causing changes in performance. For each architecture, there is a recommended maximum number of registers to use (see the CUDA Programming Guide for details). Registers may be typed (signed integer, unsigned integer, floating point, predicate) or untyped. Register size is restricted; aside from predicate registers which are 1-bit, scalar registers have a width of 8-, 16-, 32-, 64-, or 128-bits, and vector registers have a width of 16-, 32-, 64-, or 128-bits. The most common use of 8-bit registers is with ld , st , and cvt instructions, or as elements of vector tuples."
        },
        {
          "evidenceId": "CTX-04",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
          "documentSha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
          "locator": {
            "section": "5.2.1",
            "heading": "Fundamental Types",
            "anchor": "fundamental-types",
            "startLine": 3015,
            "endLine": 3062
          },
          "quotation": "In PTX, the fundamental types reflect the native data types supported by the target architectures. A fundamental type specifies both a basic type and a size. Register variables are always of a fundamental type, and instructions operate on these types. The same type-size specifiers are used for both variable definitions and for typing instructions, so their names are intentionally short. Table 8 lists the fundamental type specifiers for each basic type: Table 8 Fundamental Type Specifiers Basic Type Fundamental Type Specifiers Signed integer .s8 , .s16 , .s32 , .s64 Unsigned integer .u8 , .u16 , .u32 , .u64 Floating-point .f16 , .f16x2 , .f32 , .f64 Bits (untyped) .b8 , .b16 , .b32 , .b64 , .b128 Predicate .pred"
        }
      ],
      "unresolvedReferences": []
    },
