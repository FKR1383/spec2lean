{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/traceability/evidence-manifest-v1.json",
  "title": "Spec2Lean evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "generator",
    "runId",
    "language",
    "specificationVersion",
    "unit",
    "sourceManifest",
    "leanDocument",
    "semanticDocument",
    "sourceBundle",
    "entries",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestType": { "const": "spec2lean_evidence_manifest" },
    "generator": { "const": "spec2lean-traceability-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "sourceManifest": { "$ref": "#/$defs/fingerprint" },
    "leanDocument": { "$ref": "#/$defs/fingerprint" },
    "semanticDocument": { "$ref": "#/$defs/fingerprint" },
    "sourceBundle": { "$ref": "#/$defs/fingerprint" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarationsWithoutReferences", "unresolvedReferences"],
      "properties": {
        "declarationsWithoutReferences": { "$ref": "#/$defs/stringArray" },
        "unresolvedReferences": { "$ref": "#/$defs/stringArray" },
        "pdfAlignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched", "ambiguous", "unmatched"],
          "properties": {
            "matched": { "type": "integer", "minimum": 0 },
            "ambiguous": { "$ref": "#/$defs/stringArray" },
            "unmatched": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string" },
        "heading": { "type": "string" },
        "anchor": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "items": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceKind", "documentPath", "documentSha256", "locator"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceKind": { "enum": ["HTML", "PDF", "ARTIFACT"] },
        "documentPath": { "type": "string", "minLength": 1 },
        "documentSha256": { "$ref": "#/$defs/sha256" },
        "locator": { "$ref": "#/$defs/locator" },
        "quotation": { "type": "string" },
        "alignedFromEvidenceId": { "type": "string", "minLength": 1 },
        "alignmentMethod": { "const": "EXACT_QUOTE_TOKEN_MATCH" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticId", "classification", "statement", "evidenceIds"],
      "properties": {
        "semanticId": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["SOURCE_FACT", "DERIVED_INTERPRETATION", "DESIGN_DEPENDENCY", "ASSUMPTION", "OPEN_QUESTION"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "declarationKind",
        "declarationName",
        "leanRange",
        "semanticIds",
        "claims",
        "evidence",
        "unresolvedReferences"
      ],
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "declarationKind": { "type": "string", "minLength": 1 },
        "declarationName": { "type": "string", "minLength": 1 },
        "leanRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startLine", "endLine"],
          "properties": {
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 }
          }
        },
        "semanticIds": { "$ref": "#/$defs/stringArray" },
        "theoremObligationIds": { "$ref": "#/$defs/stringArray" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "unresolvedReferences": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
