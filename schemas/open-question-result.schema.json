{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/open-question-result.schema.json",
  "title": "Spec2Lean Phase-4 Open Question Handler Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "phase", "planRunId", "language", "version", "unit",
    "sourceDatabaseDigest", "inputEvidenceBundleHash", "inputSemanticRunId",
    "handler", "runId", "createdAt", "outcome", "questions",
    "databaseEvidenceAdded", "supplementalResolutionsAdded"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"const": "OPEN_QUESTION_HANDLER"},
    "planRunId": {"type": "string", "pattern": "^plan:"},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "unit": {"type": "object"},
    "sourceDatabaseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputEvidenceBundleHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inputSemanticRunId": {"type": "string", "pattern": "^semantic-run:"},
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning"],
      "properties": {
        "provider": {"const": "opencode"},
        "model": {"const": "openai/gpt-5.6-sol"},
        "reasoning": {"const": "medium"}
      }
    },
    "runId": {"type": "string", "pattern": "^question-run:"},
    "createdAt": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["RESOLVED", "PARTIALLY_RESOLVED", "UNRESOLVED"]},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId", "aspect", "status", "resolutionSource", "answer",
          "rationale", "references", "provenance"
        ],
        "properties": {
          "questionId": {"type": "string", "pattern": "^question:"},
          "aspect": {"type": "string", "minLength": 1},
          "status": {"enum": ["RESOLVED", "OPEN"]},
          "resolutionSource": {"enum": ["DATABASE", "INTERNET", "RUNTIME", "LLM_REASONING", "UNRESOLVED"]},
          "answer": {"type": ["string", "null"]},
          "rationale": {"type": "string", "minLength": 1},
          "references": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(evidence|resolution):"},
            "uniqueItems": true
          },
          "provenance": {"type": "object"}
        }
      }
    },
    "databaseEvidenceAdded": {
      "type": "array", "items": {"type": "string", "pattern": "^evidence:"}, "uniqueItems": true
    },
    "supplementalResolutionsAdded": {
      "type": "array", "items": {"type": "string", "pattern": "^resolution:"}, "uniqueItems": true
    }
  }
}
