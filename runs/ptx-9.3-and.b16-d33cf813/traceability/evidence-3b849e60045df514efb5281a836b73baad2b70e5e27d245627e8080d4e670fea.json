          "locator": {
            "section": "9.7.13.2",
            "heading": "Control Flow Instructions: @",
            "anchor": "control-flow-instructions-at",
            "startLine": 21834,
            "endLine": 21841,
            "page": 400
          },
          "quotation": "@{!}p    instruction;\n\nDescription\nExecute an instruction or instruction block for threads that have the guard predicate True. Threads with a False guard predicate do nothing."
        }
      ],
