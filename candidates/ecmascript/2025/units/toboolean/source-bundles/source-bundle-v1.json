      "exact_quote": "<emu-clause id=\"sec-toboolean\" oldids=\"table-toboolean-conversions\" type=\"abstract operation\" aoid=\"ToBoolean\"><span id=\"table-toboolean-conversions\"></span>",
      "context_before": "5132:     </emu-clause>",
