{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/troubleshoot-result.schema.json",
  "title": "Spec2Lean Phase-7 Troubleshooter Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "phase", "runId", "repairRunId", "planRunId", "language",
    "version", "unit", "translationRunId", "checkArtifactHash", "action", "reason",
    "failures", "diagnostics", "compilerDiagnostics", "handoff", "changedFiles",
    "changes", "hashes", "model", "opencodeVersion", "singleSession",
    "automaticRetries", "recheck", "spec2leanCommit", "startedAt", "finishedAt",
    "outcome", "error", "session"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"const": "TROUBLESHOOTER"},
    "runId": {"type": "string", "pattern": "^troubleshoot-run:"},
    "repairRunId": {"type": ["string", "null"], "pattern": "^repair-run:"},
    "planRunId": {"type": "string", "pattern": "^plan:"},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "unit": {"type": "object"},
    "translationRunId": {"type": "string", "pattern": "^translation-run:"},
    "checkArtifactHash": {"$ref": "#/$defs/hash"},
    "action": {"enum": ["RETURN_TO_SEMANTIC_EXTRACTOR", "RETURN_TO_TRANSLATOR", "REPAIR_BUILD", "NO_ACTION"]},
    "reason": {"enum": ["TRACEABILITY_FAILURE", "COVERAGE_FAILURE", "BUILD_FAILURE", "ALL_CHECKS_PASS"]},
    "failures": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "coverage", "traceability"],
      "properties": {
        "build": {"type": "boolean"},
        "coverage": {"type": "boolean"},
        "traceability": {"type": "boolean"}
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "coverage", "traceability"],
      "properties": {
        "build": {"type": "array"},
        "coverage": {"type": "array"},
        "traceability": {"type": "array"}
      }
    },
    "compilerDiagnostics": {"type": "array"},
    "handoff": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["phase", "diagnostics"],
          "properties": {
            "phase": {"enum": ["SEMANTIC_EXTRACTOR", "LLM_TRANSLATOR"]},
            "diagnostics": {"type": "array"}
          }
        }
      ]
    },
    "changedFiles": {"type": "array", "uniqueItems": true, "items": {"enum": ["Unit.lean", "translation-manifest.json"]}},
    "changes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "affectedDeclarations"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "affectedDeclarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "hashes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": {"$ref": "#/$defs/fileHashes"},
            "after": {"$ref": "#/$defs/fileHashes"}
          }
        }
      ]
    },
    "model": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "model", "reasoning"],
          "properties": {
            "provider": {"const": "opencode"},
            "model": {"const": "openai/gpt-5.3-codex-spark"},
            "reasoning": {"const": "low"}
          }
        }
      ]
    },
    "opencodeVersion": {"type": ["string", "null"]},
    "singleSession": {"type": "boolean"},
    "automaticRetries": {"const": 0},
    "recheck": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "phase", "checks", "automatic"],
      "properties": {
        "required": {"type": "boolean"},
        "phase": {"const": "CHECK"},
        "checks": {"type": "array", "uniqueItems": true, "items": {"enum": ["BUILD", "COVERAGE", "TRACEABILITY"]}},
        "automatic": {"const": false}
      }
    },
    "spec2leanCommit": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "minLength": 1},
    "finishedAt": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["ROUTED", "COMPLETE", "REPAIRED", "FAILED"]},
    "error": {"type": ["string", "null"]},
    "session": {"type": ["object", "null"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["Unit.lean", "translation-manifest.json"],
      "properties": {
        "Unit.lean": {"$ref": "#/$defs/hash"},
        "translation-manifest.json": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
