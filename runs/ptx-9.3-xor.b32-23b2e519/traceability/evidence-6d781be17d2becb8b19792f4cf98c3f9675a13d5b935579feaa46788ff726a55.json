      "claims": [
        {
          "semanticId": "PTX-XOR-SEM1-062",
          "classification": "DESIGN_DEPENDENCY",
          "statement": "Value domain design (architecture D-11, D-3): the value domain for .b32 is proposed as a fixed-width 32-bit untyped bit-value domain, because .b32 is the 'Bits (untyped)' basic type and the logic/shift family is described as fundamentally untyped, performing bit-wise operations on operands of any type of the same size.",
          "evidenceIds": [
            "PTX-9.3-XOR-010",
            "PTX-9.3-XOR-021"
          ]
        }
      ],
      "evidence": [
        {
          "evidenceId": "PTX-9.3-XOR-010",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
          "documentSha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
          "locator": {
            "section": "9.7.8",
            "heading": "Logic and Shift Instructions",
            "anchor": "logic-and-shift-instructions",
            "startLine": 14236,
            "endLine": 14255,
            "page": 254
          },
          "quotation": "9.7.8. Logic and Shift Instructions\nThe logic and shift instructions are fundamentally untyped, performing bit-wise operations on operands of any type, provided the operands are of the same size. This permits bit-wise operations on floating point values without having to define a union to access the bits. Instructions and, or, xor, and not also operate on predicates.\nThe logical shift instructions are:\nand\nor\nxor\nnot\ncnot\nlop3\nshf\nshl\nshr"
        },
        {
          "evidenceId": "PTX-9.3-XOR-021",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/nvidia/ptx/9.3/raw/ptx_isa_9.3.html",
          "documentSha256": "e2095c4ae00fe81fa18325b8e26c4a41b94965295c7affd7ff7f787fd98a8856",
          "locator": {
