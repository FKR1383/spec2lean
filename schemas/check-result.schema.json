{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.local/schemas/check-result.schema.json",
  "title": "Spec2Lean Phase-6 Check Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "phase", "planRunId", "language", "version", "unit",
    "translationRunId", "status", "build", "coverage", "traceability", "routing"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"const": "CHECK"},
    "planRunId": {"type": "string", "pattern": "^plan:"},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "unit": {"$ref": "#/$defs/unit"},
    "translationRunId": {"type": "string", "pattern": "^translation-run:"},
    "status": {"$ref": "#/$defs/status"},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "exitCode", "leanVersion", "durationMs", "diagnostics"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "exitCode": {"type": "integer"},
        "leanVersion": {"type": ["string", "null"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/buildDiagnostic"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "covered", "uncovered"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "covered": {"type": "array", "items": {"$ref": "#/$defs/coverageItem"}},
        "uncovered": {"type": "array", "items": {"$ref": "#/$defs/coverageItem"}}
      }
    },
    "traceability": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "validMappings", "brokenMappings"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "validMappings": {"type": "array", "items": {"$ref": "#/$defs/validMapping"}},
        "brokenMappings": {"type": "array", "items": {"$ref": "#/$defs/brokenMapping"}}
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false, "required": ["next"],
      "properties": {
        "next": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["COMPLETE", "TROUBLESHOOTER", "TRANSLATOR", "SEMANTIC_EXTRACTOR"]}
        }
      }
    },
    "inputHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["semantics", "leanSource", "translationManifest"],
      "properties": {
        "semantics": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "leanSource": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "translationManifest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL"]},
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unitId", "name", "sourceNodeIds"],
      "properties": {
        "unitId": {"type": "string", "pattern": "^unit:"},
        "name": {"type": "string", "minLength": 1},
        "sourceNodeIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^node:"}
        }
      }
    },
    "buildDiagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["stream", "severity", "message"],
      "properties": {
        "stream": {"enum": ["stdout", "stderr"]},
        "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
        "message": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "coverageItem": {
      "type": "object", "required": ["itemType", "itemId", "declarations"],
      "properties": {
        "itemType": {"enum": ["SEMANTIC_CLAIM", "EVIDENCE"]},
        "itemId": {"type": "string"},
        "semanticClaimIds": {"type": "array", "items": {"type": "string"}},
        "declarations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "validMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["declaration", "semanticClaimIds", "evidenceIds"],
      "properties": {
        "declaration": {"type": "string"},
        "semanticClaimIds": {"type": "array", "items": {"type": "string"}},
        "evidenceIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "brokenMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "declaration": {"type": "string"},
        "semanticClaimId": {"type": "string"},
        "evidenceId": {"type": "string"},
        "sourceNodeId": {"type": "string"},
        "sourceSpanId": {"type": "string"}
      }
    }
  }
}
