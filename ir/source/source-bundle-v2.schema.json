{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/source/source-bundle-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "language",
    "specification_version",
    "unit",
    "source_documents",
    "fragments",
    "evidence_gaps"
  ],
  "properties": {
    "schema_version": { "enum": [2, 3] },
    "bundle_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specification_version": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "publisher", "kind", "local_path", "sha256"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["HTML", "PDF"] },
          "local_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id",
          "document_id",
          "source_kind",
          "source_sha256",
          "exact_quote",
          "locator",
          "reason_for_inclusion"
        ],
        "properties": {
          "fragment_id": { "type": "string", "minLength": 1 },
          "document_id": { "type": "string", "minLength": 1 },
          "source_kind": { "enum": ["HTML", "PDF"] },
          "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "exact_quote": { "type": "string", "minLength": 1 },
          "context": { "type": "string" },
          "locator": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "section": { "type": "string" },
              "heading": { "type": "string" },
              "anchor": { "type": "string" },
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "page": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "reason_for_inclusion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "statement", "impact"],
        "properties": {
          "gap_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["LOAD_BEARING", "NON_LOAD_BEARING"] }
        }
      }
    },
    "coverage_matrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "status", "fragment_ids", "gap_ids", "rationale"],
        "properties": {
          "dimension": { "enum": ["SYNTAX", "OPERANDS", "TYPES", "OPERATION_BRANCHES", "EDGE_CASES", "GUARDS", "STATE_EFFECTS", "ERRORS", "VERSION_APPLICABILITY"] },
          "status": { "enum": ["COVERED", "NOT_APPLICABLE", "GAP"] },
          "fragment_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "gap_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 3 } } },
      "then": { "required": ["coverage_matrix"] }
    }
  ]
}
