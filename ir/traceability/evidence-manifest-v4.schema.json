{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2lean.dev/schema/traceability/evidence-manifest-v4.json",
  "title": "Spec2Lean evidence manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "generator",
    "runId",
    "language",
    "specificationVersion",
    "unit",
    "documentRole",
    "sourceManifest",
    "leanDocument",
    "semanticDocument",
    "sourceBundles",
    "entries",
    "semanticUncertainties",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "manifestType": { "const": "spec2lean_evidence_manifest" },
    "generator": { "const": "spec2lean-traceability-v4" },
    "runId": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "specificationVersion": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "documentRole": { "enum": ["SEMANTICS", "PROOFS"] },
    "sourceManifest": { "$ref": "#/$defs/fingerprint" },
    "leanDocument": { "$ref": "#/$defs/fingerprint" },
    "semanticDocument": { "$ref": "#/$defs/fingerprint" },
    "architectureDocument": { "$ref": "#/$defs/fingerprint" },
    "sourceBundles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fingerprint" }
    },
    "theoremDocument": { "$ref": "#/$defs/fingerprint" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "semanticUncertainties": {
      "type": "array",
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "allOf": [
    {
      "if": { "properties": { "documentRole": { "const": "PROOFS" } } },
      "then": { "required": ["theoremDocument"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string" },
        "heading": { "type": "string" },
        "anchor": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "items": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceKind", "documentPath", "documentSha256", "locator"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceKind": { "enum": ["HTML", "PDF", "ARTIFACT"] },
        "documentPath": { "type": "string", "minLength": 1 },
        "documentSha256": { "$ref": "#/$defs/sha256" },
        "locator": { "$ref": "#/$defs/locator" },
        "quotation": { "type": "string" },
        "alignedFromEvidenceId": { "type": "string", "minLength": 1 },
        "alignmentMethod": {
          "enum": [
            "EXACT_QUOTE_TOKEN_MATCH",
            "PAGE_HINTED_EXACT_QUOTE_TOKEN_MATCH",
            "DISTINCTIVE_TOKEN_WINDOW_MATCH"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticId",
        "classification",
        "statement",
        "evidenceIds",
        "dependencyIds",
        "humanApprovalDependencies",
        "origin",
        "unresolved"
      ],
      "properties": {
        "semanticId": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["SOURCE_FACT", "DERIVED_INTERPRETATION", "DESIGN_DEPENDENCY", "ASSUMPTION", "OPEN_QUESTION"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/stringArray" },
        "dependencyIds": { "$ref": "#/$defs/stringArray" },
        "humanApprovalDependencies": { "$ref": "#/$defs/stringArray" },
        "origin": { "enum": ["SEMANTICS", "ARCHITECTURE"] },
        "stateAffecting": { "type": "boolean" },
        "unresolved": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directClaimIds",
        "transitiveClaimIds",
        "sourceFactIds",
        "projectBoundaryIds",
        "officialEvidenceIds",
        "pdfEvidenceIds",
        "projectEvidenceIds",
        "unresolvedDependencyIds"
      ],
      "properties": {
        "directClaimIds": { "$ref": "#/$defs/stringArray" },
        "transitiveClaimIds": { "$ref": "#/$defs/stringArray" },
        "sourceFactIds": { "$ref": "#/$defs/stringArray" },
        "projectBoundaryIds": { "$ref": "#/$defs/stringArray" },
        "officialEvidenceIds": { "$ref": "#/$defs/stringArray" },
        "pdfEvidenceIds": { "$ref": "#/$defs/stringArray" },
        "projectEvidenceIds": { "$ref": "#/$defs/stringArray" },
        "unresolvedDependencyIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "declarationKind",
        "declarationName",
        "leanRange",
        "semanticIds",
        "theoremObligationIds",
        "claims",
        "evidence",
        "unresolvedReferences",
        "coverage"
      ],
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "declarationKind": { "type": "string", "minLength": 1 },
        "declarationName": { "type": "string", "minLength": 1 },
        "leanRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startLine", "endLine"],
          "properties": {
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 }
          }
        },
        "semanticIds": { "$ref": "#/$defs/stringArray" },
        "theoremObligationIds": { "$ref": "#/$defs/stringArray" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "unresolvedReferences": { "$ref": "#/$defs/stringArray" },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["semanticId", "statement", "origin", "unresolved"],
      "properties": {
        "semanticId": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["SEMANTICS", "ARCHITECTURE"] },
        "stateAffecting": { "type": "boolean" },
        "unresolved": { "const": true },
        "benchmarkDisposition": { "type": "object" }
      }
    },
    "pdfAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "matched", "ambiguous", "unmatched", "coverageRatio"],
      "properties": {
        "eligible": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "ambiguous": { "$ref": "#/$defs/stringArray" },
        "unmatched": { "$ref": "#/$defs/stringArray" },
        "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "failure": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredOfficialRenditions",
        "declarationsWithoutReferences",
        "unresolvedReferences",
        "declarationsWithoutEvidencePath",
        "claimsWithoutDependencyPath",
        "sourceFactsWithoutOfficialEvidence",
        "sourceFactsWithoutHtmlEvidence",
        "sourceFactsWithoutPdfEvidence",
        "assumptionsWithoutApprovalDependency",
        "unresolvedOpenQuestions"
      ],
      "properties": {
        "requiredOfficialRenditions": {
          "type": "array",
          "items": { "enum": ["HTML", "PDF"] },
          "uniqueItems": true
        },
        "declarationsWithoutReferences": { "$ref": "#/$defs/stringArray" },
        "unresolvedReferences": { "$ref": "#/$defs/stringArray" },
        "declarationsWithoutEvidencePath": { "$ref": "#/$defs/stringArray" },
        "claimsWithoutDependencyPath": { "$ref": "#/$defs/stringArray" },
        "sourceFactsWithoutOfficialEvidence": { "$ref": "#/$defs/stringArray" },
        "sourceFactsWithoutHtmlEvidence": { "$ref": "#/$defs/stringArray" },
        "sourceFactsWithoutPdfEvidence": { "$ref": "#/$defs/stringArray" },
        "assumptionsWithoutApprovalDependency": { "$ref": "#/$defs/stringArray" },
        "unresolvedOpenQuestions": { "$ref": "#/$defs/stringArray" },
        "pdfAlignment": { "$ref": "#/$defs/pdfAlignment" }
      }
    }
  }
}
