            "startLine": 5136,
            "endLine": 5136
          },
          "quotation": "NOTE: This step is replaced in section <emu-xref href=\"#sec-IsHTMLDDA-internal-slot-to-boolean\" id=\"_ref_201\"><a href=\"#sec-IsHTMLDDA-internal-slot-to-boolean\">B.3.6.1</a></emu-xref>."
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-006",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/ecmascript/2025/raw/specification.html",
          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
          "locator": {
            "section": "7.1.2",
            "heading": "ToBoolean",
            "anchor": "sec-toboolean",
            "startLine": 5136,
            "endLine": 5136
          },
          "quotation": "Return <emu-val>true</emu-val>."
        },
        {
          "evidenceId": "ECMASCRIPT-2025-TOB-V3-007",
          "sourceKind": "HTML",
          "documentPath": "documents/sources/ecmascript/2025/raw/specification.html",
          "documentSha256": "6a28f9423133ed7b7c59a40baf620c2740f12f0bc9c251042f2a85b9cc5ed713",
